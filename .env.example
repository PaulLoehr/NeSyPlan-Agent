# Copy this file to `.env` and fill in ONE key. `.env` is gitignored.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# OpenRouter -- the default, and all you need.
# ---------------------------------------------------------------------------
# Get a key at https://openrouter.ai/keys. The models this repository defaults to
# (qwen3-32b and its smaller siblings) are paid, so the account needs some credit --
# an account with zero credit gets HTTP 402 before the model ever runs.
#
# One account setting matters: if a model reports
#   "No endpoints available matching your guardrail restrictions and data policy"
# open https://openrouter.ai/settings/privacy and allow the upstream providers you
# are willing to use. (qwen3-8b in particular has a single upstream and is blocked
# by the default policy; qwen3-14b / -30b-a3b / -32b are not.)
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Optional: a different OpenAI-compatible endpoint
# ---------------------------------------------------------------------------
# Any endpoint that speaks /v1/chat/completions with tool calling works. Point the
# Phoenix route at it and select a model with --model <its-model-id>.
# BEARER_TOKEN=
# PHOENIX_BASE_URL=https://your-endpoint.example/v1
# PHOENIX_BACKEND=

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------
# AGENT_MODEL=qwen3-32b        # default model for every entry point
# AGENT_CONTEXT_WINDOW=40960   # token window used by the context meter
# LLM_LOG_DIR=llm_logs         # where session transcripts are written
# NESYPLAN_SUMMARIZER_MODEL=qwen3-32b
#                              # the SUMMARY cache's side-call. Pinned to ONE model
#                              # regardless of which model is driving, so summarization
#                              # quality stays constant when drivers are compared.
